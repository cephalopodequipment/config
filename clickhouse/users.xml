<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>

            <load_balancing>random</load_balancing>
        </default>

        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <users>
        <default>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
        <signoz>
            <no_password/>
            <networks>
                <ip>10.10.12.106</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </signoz>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>

                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
